# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# convex
.convex

# typescript
*.tsbuildinfo
next-env.d.ts

# Instagram sidecar secrets
ig-bridge/ig_session.json
ig-bridge/__pycache__/
*.pyc

# local sqlite db
data/

# python venv for ig-bridge
ig-bridge/.venv/
ig_session.json

# pipeline venv / tessdata / caches
pipeline/.venv/
pipeline/tessdata/
pipeline/**/__pycache__/

# agent skills (installed via `npx skills add`, symlinked into .claude/skills)
/.agents/
/.claude/skills/
.gstack/

# vite
/dist/
/dist-server/

# browser automation snapshots and logs
.playwright-cli/
